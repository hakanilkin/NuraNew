# Nura environment variables — copy to .env and fill in real values.
# Never commit the real .env (it is gitignored).

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development          # set to "production" on the server
PORT=3000

# ── Session ──────────────────────────────────────────────────────────
# Long random string. REQUIRED in production (server refuses to start without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Auth database (NuraOps) ──────────────────────────────────────────
# Holds Users, Tenants, UserTenants. Per-tenant analytics DBs are read
# from the Tenants table, not from these vars.
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password
AUTH_DB_DATABASE=NuraOps

# Set to "true" ONLY for local SQL Server with a self-signed certificate.
# Leave unset/false for Azure SQL so TLS certificates are verified.
DB_TRUST_SERVER_CERT=false

# ── Tenant credential encryption ─────────────────────────────────────
# Encrypts tenant DB passwords at rest (AES-256-GCM). Without it, passwords
# are stored as plaintext. Back this key up — if lost, stored tenant
# passwords cannot be decrypted and must be re-entered.
# Generate: openssl rand -hex 32
TENANT_DB_ENC_KEY=

# ── External APIs ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # powers Ask Nura and Atlas narrative explanations
BLAZESQL_API_KEY=             # BlazeSql embed (optional feature)

# ── Python pipelines only (*_pipeline.py, pull_q1_2026_data.py) ──────
# These connect directly to a single analytics DB to train/export models.
DB_DATABASE=your_analytics_db

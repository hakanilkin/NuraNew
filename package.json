{
  "name": "surgical-dashboard",
  "version": "1.0.0",
  "description": "Surgical Services Operational Performance Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm install && npm run build",
    "check:unit-categories": "node scripts/checks/unit_category_regression.js",
    "check": "npm run check:unit-categories && npm run check:briefs-focus && npm run check:isscm && npm run check:shared-libs",
    "check:briefs-focus": "node --test scripts/checks/briefs_focus_classifier.test.js",
    "check:isscm": "node --test scripts/checks/isscm_scenario.test.js",
    "check:shared-libs": "node --test scripts/checks/shared_libs.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mssql-v2": "^6.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "mssql": "^10.0.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  }
}

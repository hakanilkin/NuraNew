{
  "name": "surgical-dashboard",
  "version": "1.0.0",
  "description": "Surgical Services Operational Performance Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm install && npm run build",
    "check:unit-categories": "node scripts/checks/unit_category_regression.js",
    "check": "npm run check:unit-categories && npm run check:isscm && npm run check:shared-libs && npm run check:routes && npm run check:fulfillment && npm run check:demand-signal && npm run check:block-patterns && npm run check:breakdown && npm run check:rtdc",
    "check:isscm": "node --test scripts/checks/isscm_scenario.test.js",
    "check:shared-libs": "node --test scripts/checks/shared_libs.test.js",
    "check:routes": "node --test scripts/checks/routes_smoke.test.js",
    "check:fulfillment": "node --test scripts/checks/opentime_fulfillment.test.js",
    "check:demand-signal": "node --test scripts/checks/demand_signal.test.js",
    "check:block-patterns": "python3 scripts/checks/block_patterns_test.py",
    "check:breakdown": "python3 scripts/checks/service_line_breakdown_acceptance.py",
    "check:rtdc": "node --test scripts/checks/rtdc.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mssql-v2": "^6.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "mssql": "^10.0.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  }
}
